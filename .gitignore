# Data and outputs are regenerated by the pipeline, never committed
data/
outputs/

# Environment
.venv/
.env
*.env

# Credentials — never committed. Created by the developer, not by this repo.
config/.env
config/*-service-account.json
config/*.credentials

# Editable install metadata
*.egg-info/
build/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
